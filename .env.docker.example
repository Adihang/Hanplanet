# Copy this file to .env before running docker compose.
# Keep .env out of Git. Use long random values for every secret in production.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-to-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=hanplanet.com,www.hanplanet.com,mc.hanplanet.com,rlc.hanplanet.com,git.hanplanet.com,game.hanplanet.com,map-collab.hanplanet.com,wargame.hanplanet.com,localhost,127.0.0.1,django,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,https://hanplanet.com,https://www.hanplanet.com,https://mc.hanplanet.com,https://rlc.hanplanet.com,https://git.hanplanet.com,https://game.hanplanet.com,https://map-collab.hanplanet.com
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SERVE_FILES=false
PUBLIC_BASE_URL=http://localhost:8080
CANONICAL_PUBLIC_HOST_REDIRECT=false
DJANGO_SQLITE_PATH=/data/django/db.sqlite3

# Production example:
# DJANGO_DEBUG=false
# PUBLIC_BASE_URL=https://www.hanplanet.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# CANONICAL_PUBLIC_HOST_REDIRECT=true

# ---------------------------------------------------------------------------
# Ports exposed on the Docker host
# ---------------------------------------------------------------------------
HTTP_PORT=8080
DJANGO_PORT=8000
GITEA_PORT=3000
GAME_PORT=8081
GAME_ADMIN_PORT=8082
MAP_COLLAB_PORT=8083
MAP_COLLAB_ADMIN_PORT=8084
WARGAME_PORT=8090

# ---------------------------------------------------------------------------
# Persistent storage inside containers
# ---------------------------------------------------------------------------
HANPLANET_MEDIA_ROOT=/data/media
HANPLANET_ONSCRIPTER_ROOT=/data/ONScripter
HANPLANET_CLI_ROOT=/data/HanPlanet-CLI
HANPLANET_FORGEJO_REPOS_ROOT=/data/forgejo-repos
HANPLANET_GITHUB_REPO_CACHE_ROOT=/data/github-repo-cache
HANDRIVE_HLS_CACHE_ROOT=/data/media/hls_cache
HANPLANET_OFFICE_FONTS_ROOT=/usr/local/share/fonts/hanplanet-office
HPMAIL_STORAGE_ROOT=/data/mail
DATA_BACKUP_ROOT=/data/backups
DATA_BACKUP_RETENTION_DAYS=3
HANPLANET_DOCKER_SECRETS_DIR=./.local/docker-secrets

# Named Docker volumes are the portable default.
DJANGO_DATA_VOLUME=django_data
HANPLANET_MEDIA_VOLUME=media_data
HANPLANET_ONSCRIPTER_VOLUME=onscripter_data
HANPLANET_CLI_VOLUME=hanplanet_cli_data
HANPLANET_MAIL_VOLUME=mail_data
HANPLANET_GITHUB_CACHE_VOLUME=github_cache_data
FORGEJO_REPOS_VOLUME=forgejo_repos_data
HANPLANET_BACKUP_VOLUME=backup_data
HANPLANET_OFFICE_FONTS_VOLUME=.local/office-preview-fonts
GITEA_DATA_VOLUME=gitea_data
REDIS_DATA_VOLUME=redis_data
WARGAME_DATA_VOLUME=wargame_data
MINECRAFT_SERVER_VOLUME=/Users/imhanbyeol/Development/minecraft-fabric
MINECRAFT_SERVER_DIR=/Users/imhanbyeol/Development/minecraft-fabric
MINECRAFT_CONSOLE_OUTPUT_PATH=/Users/imhanbyeol/Development/minecraft-fabric/run/console.out
MINECRAFT_CONSOLE_TRANSPORT=rcon
MINECRAFT_RCON_HOST=host.docker.internal
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_TIMEOUT_SECONDS=3
PROMINENCE_CONSOLE_OUTPUT_PATH=/Users/imhanbyeol/Development/rlcraft/run/console.out
PROMINENCE_CONSOLE_INPUT_PATH=/Users/imhanbyeol/Development/rlcraft/run/console.in
PROMINENCE_CONSOLE_INPUT_VOLUME=/Users/imhanbyeol/Development/rlcraft/run/console.in
PROMINENCE_CONSOLE_TRANSPORT=bridge
PROMINENCE_CONSOLE_BRIDGE_HOST=host.docker.internal
PROMINENCE_CONSOLE_BRIDGE_PORT=25576
PROMINENCE_CONSOLE_BRIDGE_TOKEN=replace-with-a-long-random-token

# Host bind-mount example for production data:
# DJANGO_DATA_VOLUME=/srv/hanplanet/django
# HANPLANET_MEDIA_VOLUME=/srv/hanplanet/media
# HANPLANET_ONSCRIPTER_VOLUME=/srv/hanplanet/ONScripter
# HANPLANET_CLI_VOLUME=/srv/hanplanet/HanPlanet-CLI
# HANPLANET_MAIL_VOLUME=/srv/hanplanet/mail
# HANPLANET_GITHUB_CACHE_VOLUME=/srv/hanplanet/github-repo-cache
# FORGEJO_REPOS_VOLUME=/srv/hanplanet/forgejo-repos
# HANPLANET_BACKUP_VOLUME=/srv/hanplanet/backups
# HANPLANET_OFFICE_FONTS_VOLUME=/srv/hanplanet/office-preview-fonts
# GITEA_DATA_VOLUME=/srv/hanplanet/gitea
# REDIS_DATA_VOLUME=/srv/hanplanet/redis
# WARGAME_DATA_VOLUME=/srv/hanplanet/wargame
# MINECRAFT_SERVER_VOLUME=/srv/hanplanet/minecraft

# ---------------------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
HANDRIVE_TUTORIAL_WORKSPACE_MAX_AGE_SECONDS=86400
HANDRIVE_TUTORIAL_WORKSPACE_CLEANUP_INTERVAL_SECONDS=3600
# HanDrive application-level upload/download cap (decimal bytes per second).
HANDRIVE_TRANSFER_RATE_BYTES_PER_SECOND=10000000
RUN_MIGRATIONS=true
COLLECTSTATIC_ON_START=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=360

# ---------------------------------------------------------------------------
# Forgejo / Gitea
# ---------------------------------------------------------------------------
FORGEJO_BASE_URL=http://gitea:3000
FORGEJO_ADMIN_TOKEN=
PUBLIC_GIT_BASE_URL=http://localhost:3000
# Gitea 컨테이너 내부 DB 경로와 Django 컨테이너의 마운트 경로는 다르다.
FORGEJO_DB_PATH=/data/gitea/gitea.db
GITEA_DB_PATH=/data/gitea.db
GITEA_DOMAIN=localhost
GITEA_SSH_DOMAIN=localhost
GITEA_DISABLE_SSH=true
GITEA_DISABLE_REGISTRATION=true

# Production example:
# PUBLIC_GIT_BASE_URL=https://git.hanplanet.com
# GITEA_DOMAIN=git.hanplanet.com
# GITEA_SSH_DOMAIN=git.hanplanet.com

# ---------------------------------------------------------------------------
# Realtime game and map collaboration
# ---------------------------------------------------------------------------
GAME_JWT_SECRET=change-this-game-jwt-secret
WARGAME_COMPLETION_SECRET=
GAME_JWT_ISSUER=http://localhost:8080
GAME_JWT_AUDIENCE=hanplanet-game
GAME_WS_PUBLIC_URL=ws://localhost:8081
GAME_WS_LOCAL_URL=ws://bumpercar-spiky-server:8080
GAME_ADMIN_URL=http://bumpercar-spiky-server:8082
BUMPERCAR_SPIKY_SETTINGS_PATH=/data/django/bumpercar_spiky_settings.json
BUMPERCAR_SPIKY_INTERNAL_SECRET=change-this-bumpercar-internal-secret
MAP_COLLAB_WS_PUBLIC_URL=ws://localhost:8083
MAP_COLLAB_WS_LOCAL_URL=ws://map-collab-server:8083
MAP_COLLAB_ADMIN_URL=http://map-collab-server:8084
SYNC_JWT_SECRET=change-this-sync-jwt-secret

# Production example:
# GAME_JWT_ISSUER=https://www.hanplanet.com
# GAME_WS_PUBLIC_URL=wss://game.hanplanet.com
# MAP_COLLAB_WS_PUBLIC_URL=wss://map-collab.hanplanet.com

# ---------------------------------------------------------------------------
# AI / Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_PROXY_API_KEY=
OIDC_RSA_PRIVATE_KEY_FILE=

# ---------------------------------------------------------------------------
# External OAuth / storage integrations
# ---------------------------------------------------------------------------
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_AUTH_CALLBACK_URL=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_CALLBACK_URL=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=handrive
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

# ---------------------------------------------------------------------------
# HPmail host-service bridge
# ---------------------------------------------------------------------------
# Postfix/Dovecot are still host services unless separately containerized.
HPMAIL_DOMAIN=hanplanet.com
HPMAIL_IMAP_HOST=host.docker.internal
HPMAIL_IMAP_PORT=143
HPMAIL_IMAP_USE_TLS=false
HPMAIL_IMAP_MASTER_USER=
HPMAIL_IMAP_MASTER_PASSWORD=
HPMAIL_SMTP_HOST=host.docker.internal
HPMAIL_SMTP_PORT=25
HPMAIL_SMTP_USE_TLS=false
HPMAIL_SMTP_USERNAME=
HPMAIL_SMTP_PASSWORD=

# Wargame mission dispatch (production: set a real relay; SMTP auth requires tls)
# WARGAME_COMPLETION_SECRET above must be a separate long random value before launch.
WARGAME_DJANGO_BASE_URL=https://www.hanplanet.com
WARGAME_PUBLIC_URL=https://wargame.hanplanet.com/
# First-party OIDC client used by the Wargame portal. Public PKCE clients do not need a secret.
WARGAME_OIDC_CLIENT_ID=hanplanet-wargame-sso
WARGAME_OIDC_CLIENT_SECRET=
WARGAME_OIDC_REDIRECT_URI=https://wargame.hanplanet.com/auth/callback.php
FORGEJO_OIDC_SSO_ENABLED=true
FORGEJO_OIDC_CLIENT_ID=gitea-hanplanet-sso
WARGAME_MAIL_TRANSPORT=smtp
WARGAME_MAIL_FROM=operations@wargame.hanplanet.com
WARGAME_SMTP_HOST=host.docker.internal
WARGAME_SMTP_PORT=25
WARGAME_SMTP_SECURITY=none
WARGAME_SMTP_TLS_PEER_NAME=
WARGAME_SMTP_USERNAME=
WARGAME_SMTP_PASSWORD=
WARGAME_SMTP_TIMEOUT=5

# ---------------------------------------------------------------------------
# Optional security and provider keys
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BUNGIE_API_KEY=
MINECRAFT_LINK_SHARED_SECRET=
# Optional yt-dlp extractor override. Keep empty unless a current YouTube workaround requires it.
YOUTUBE_DOWNLOAD_EXTRACTOR_ARGS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hanplanet.com
