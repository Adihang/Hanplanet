{{/* Hanplanet custom theme */}}
{{/* FOUC 방지 — CSS 로드 전 배경색 즉시 적용 (www base.html 동일 패턴) */}}
<style data-surface-light="base-preload">
  html.preload-light-bg,
  html.preload-light-bg body {
    background: #ffffff;
    background-image: none;
  }
  html.preload-dark-bg,
  html.preload-dark-bg body {
    background: #222222;
    background-image: none;
  }
  body.theme-preinit,
  body.theme-preinit * {
    transition: none;
    animation: none;
  }
</style>
<script>
(function () {
  try {
    var cookieMatch = document.cookie.match(/(?:^|;\s*)portfolio_theme_mode=([^;]+)/);
    var stored = (cookieMatch ? decodeURIComponent(cookieMatch[1]) : null) || window.localStorage.getItem('portfolio_theme_mode');
    var prefersDark;
    if (stored === 'dark') {
      prefersDark = true;
    } else if (stored === 'light') {
      prefersDark = false;
    } else {
      prefersDark = Boolean(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
    }
    document.documentElement.classList.add(prefersDark ? 'preload-dark-bg' : 'preload-light-bg');
  } catch (e) {
    document.documentElement.classList.add('preload-light-bg');
  }
})();
</script>
<script>
(function () {
  var isSigned = {{if .IsSigned}}true{{else}}false{{end}};

  function getCookie(name) {
    try {
      var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
      if (!m) return null;
      var raw = m[1].trim();
      if (raw.charAt(0) === '"' && raw.charAt(raw.length - 1) === '"') {
        raw = raw.slice(1, -1);
      }
      return decodeURIComponent(raw);
    } catch (e) { return null; }
  }

  function redirectToHanplanetLogin() {
    var htmlLang = (document.documentElement && document.documentElement.lang) || '';
    var lang = /^en(?:-|$)/i.test(htmlLang) ? 'en' : 'ko';
    var target = 'https://git.hanplanet.com/';
    try {
      var url = new URL(window.location.href);
      var redirectTo = url.searchParams.get('redirect_to') || '/';
      target = new URL(redirectTo, 'https://git.hanplanet.com').toString();
    } catch (e) {}
    window.location.replace('https://www.hanplanet.com/' + lang + '/login/?next=' + encodeURIComponent(target));
  }

  var path = window.location.pathname;
  if ((path === '/user/login' || path === '/user/login/') && !getCookie('hp_logout_return')) {
    redirectToHanplanetLogin();
    return;
  }

  if (isSigned) {
    return;
  }
  if (!getCookie('hp_account_active')) {
    return;
  }
  if (getCookie('hp_sso_probe_failed') || getCookie('hp_sso_probe_attempted')) {
    return;
  }
  if (
    path === '/user/login' || path === '/user/login/' ||
    path.indexOf('/user/oauth2/') === 0 ||
    path.indexOf('/user/link_account') === 0 ||
    path.indexOf('/user/logout') === 0
  ) {
    return;
  }

  window.location.replace(
    'https://www.hanplanet.com/sso/gitea?probe=1&next=' + encodeURIComponent(window.location.href)
  );
})();
</script>
